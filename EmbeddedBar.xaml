<Window x:Class="LyricBar.EmbeddedBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricBar Embedded"
        Width="720" Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="#000000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent"
          MouseEnter="OnRootEnter" MouseLeave="OnRootLeave">
        <Border x:Name="Shell" CornerRadius="8" Background="#00000000" Margin="2,0">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="设置…" Click="OnOpenSettings"/>
                    <Separator/>
                    <MenuItem Header="靠图标排列" Click="OnAlignLeft"/>
                    <MenuItem Header="居中" Click="OnAlignCenter"/>
                    <MenuItem Header="靠托盘排列" Click="OnAlignRight"/>
                    <Separator/>
                    <MenuItem Header="切换到贴边浮窗" Click="OnSwitchMode"/>
                    <MenuItem Header="重新匹配歌词" Click="OnReloadLyrics"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="OnExit"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid x:Name="Row" Margin="10,0,9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="LyricCol" Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧强调色竖条，给一点精致感 -->
                <Border x:Name="AccentBar" Grid.Column="0" Width="2.5" Height="16"
                        CornerRadius="1.25" Background="#4CC2FF" VerticalAlignment="Center"
                        Margin="0,0,9,0"/>

                <Border x:Name="CoverBox" Grid.Column="1" Width="20" Height="20" CornerRadius="4"
                        Background="#26FFFFFF" ClipToBounds="True" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                    <Image x:Name="Cover" Stretch="UniformToFill"/>
                </Border>

                <!-- 歌名是独立模块：自己一列、自己滚动（停 5 秒滚一次），不跟歌词一起动 -->
                <Grid x:Name="TrackHost" Grid.Column="2" VerticalAlignment="Center" ClipToBounds="True"
                      HorizontalAlignment="Left" MaxWidth="170" Margin="0,0,8,0"
                      SizeChanged="OnTrackHostSizeChanged">
                    <TextBlock x:Name="TrackText" VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               FontSize="11" Foreground="#66FFFFFF"/>
                </Grid>

                <!-- 歌词区：左右线性渐隐；长句走马灯；按钮展开时自动让位 -->
                <Grid x:Name="LyricHost" Grid.Column="3" VerticalAlignment="Center" ClipToBounds="True"
                      SizeChanged="OnLyricHostSizeChanged">
                    <StackPanel x:Name="TextStack" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <TextBlock x:Name="LyricText" Text="未在播放" VerticalAlignment="Center"
                                   FontSize="13" Foreground="#F0FFFFFF"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- 控制按钮：悬停才展开，宽度从 0 拉出来，不占常驻空间 -->
                <Border x:Name="ControlsHost" Grid.Column="4" Background="Transparent"
                        VerticalAlignment="Center" MaxWidth="0" Opacity="0" ClipToBounds="True">
                    <StackPanel x:Name="Controls" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Button x:Name="PrevBtn" Style="{StaticResource TinyBtn}" Content="&#xE892;"
                                Foreground="#CCFFFFFF" Click="OnPrev"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource TinyBtn}" Content="&#xE768;"
                                Foreground="#CCFFFFFF" Click="OnPlay" Margin="1,0"/>
                        <Button x:Name="NextBtn" Style="{StaticResource TinyBtn}" Content="&#xE893;"
                                Foreground="#CCFFFFFF" Click="OnNext"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
